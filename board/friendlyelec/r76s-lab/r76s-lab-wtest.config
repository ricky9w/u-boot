# eMMC write test variant of the hybrid test build, merged after
# r76s-hybrid.config and r76s-hybrid-test.config. Before it boots NixOS like
# the test variant, it does what the hybrid build's r76s_boot does to the eMMC
# when it takes a try (r76s-hybrid.env), on sector 0x7001 (sector 4097 of misc,
# unused): it reads the misc sector and prints its two words, writes a copy of
# the first FIT header there, reads it back, then zeros it and reads it back.
CONFIG_BOOTCOMMAND="r76s info; mmc dev 0 && mmc read ${r76s_buf} ${r76s_misc} 1 && setexpr.l r76s_st *${r76s_buf} && setexpr r76s_mark ${r76s_buf} + 4 && setexpr.l r76s_ft *${r76s_mark} && echo r76s-lab: misc words ${r76s_st} ${r76s_ft}; if mmc read ${r76s_buf} ${r76s_fit} 1 && mmc write ${r76s_buf} 0x7001 1 && mmc read ${loadaddr} 0x7001 1 && cmp.l ${r76s_buf} ${loadaddr} 0x80 && mw.l ${r76s_zero} 0 0x80 && mmc write ${r76s_zero} 0x7001 1 && mmc read ${loadaddr} 0x7001 1 && cmp.l ${r76s_zero} ${loadaddr} 0x80; then echo r76s-lab: write test passed; else echo r76s-lab: write test failed; fi; r76s optee && sysboot mmc 0:b any ${pxefile_addr_r} /extlinux/extlinux.conf; echo r76s-lab: booting failed; reset"
