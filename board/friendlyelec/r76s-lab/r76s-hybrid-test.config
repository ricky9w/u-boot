# Test of the hybrid build before it goes into the FIT, with the vendor
# U-Boot's fallback: in the boot states UBT3/UBT2/UBT1 the vendor boot script
# (install/bootcmd.txt in r76s-nixos) saves the ATAGS to 0x40700000 and boots
# /boot/uboot/u-boot.bin like a kernel at this build's link address, after it
# has counted the boot state down. So this only boots NixOS. The vendor U-Boot
# clears the start of the ATAGS before it jumps; board_early_init_f() puts the
# saved copy back, so the DRAM banks and the OP-TEE memory come from them as
# when the vendor SPL starts the hybrid build.
CONFIG_BOARD_EARLY_INIT_F=y
CONFIG_R76S_LAB_ATAGS_COPY=0x40700000
CONFIG_BOOTCOMMAND="r76s info; r76s optee && sysboot mmc 0:b any ${pxefile_addr_r} /extlinux/extlinux.conf; echo r76s-lab: booting failed; reset"
