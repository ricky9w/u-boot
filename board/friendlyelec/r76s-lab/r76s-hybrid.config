# NanoPi R76S hybrid build: mainline U-Boot proper, started by the vendor SPL
# and BL31 from the first FIT copy in the uboot partition, with the vendor FIT
# as the second copy (r76s-hybrid.env says how the two are used). Merge after
# nanopi-r76s-rk3576_defconfig:
#   make nanopi-r76s-rk3576_defconfig r76s-hybrid.config [r76s-hybrid-test.config [r76s-lab-diag.config]]
# The FIT is packed from u-boot.bin and the vendor FIT's BL31 and OP-TEE.
CONFIG_R76S_LAB=y
CONFIG_ENV_SOURCE_FILE="friendlyelec/r76s-lab/r76s-hybrid"
# Never write the environment or EFI variables to the eMMC.
CONFIG_ENV_IS_NOWHERE=y
# CONFIG_EFI_LOADER is not set
# Leave the PCIe network cards alone.
# CONFIG_PCI_INIT_R is not set
# The watchdog runs from early in U-Boot with its longest timeout (89 s at
# 24 MHz) and stays running for the kernel, whose dw_wdt driver takes it over.
CONFIG_WDT=y
CONFIG_DESIGNWARE_WATCHDOG=y
CONFIG_WATCHDOG_AUTOSTART=y
CONFIG_WATCHDOG_TIMEOUT_MSECS=89000
CONFIG_CMD_SETEXPR=y
CONFIG_CMD_SYSBOOT=y
# No serial console is attached: boot without waiting or checking for a key.
CONFIG_BOOTDELAY=-2
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="run r76s_boot"
