# Diagnostics variant of the hybrid test build, merged after
# r76s-hybrid.config and r76s-hybrid-test.config: it reports and reads, then
# resets without booting a kernel. The eMMC as probed (with the CRU reset) and
# initialized, a read test (2 x 32 MiB), then the same after probing the
# controller again. The run takes seconds.
CONFIG_BOOTCOMMAND="r76s regs after-probe; r76s info; r76s regs after-init; part start mmc 0 0xb p11 && r76s readtest ${p11} 0x10000 2 0x60000000; r76s reprobe; r76s regs after-reprobe; part start mmc 0 0xb p11 && r76s readtest ${p11} 0x10000 2 0x60000000; echo r76s-lab: diagnostics done; reset"
