/*
 * NanoPi R76S hybrid build: which system to boot. The vendor SPL and BL31
 * start this U-Boot from the first of the two FIT copies in the uboot
 * partition (eMMC sectors 0x4000 and 0x5000); the second copy is the vendor
 * FIT. When the first copy does not start with a FIT header, the vendor SPL
 * loads the second one, and the vendor U-Boot boots as it did before. So
 * zeroing sector 0x4000 hands the next boot to the vendor U-Boot.
 *
 * The first 8 bytes of eMMC sector 0x7000 (sector 4096 of misc) hold:
 *   word 0  the boot state, as for the vendor boot script: NIX3, NIX2, NIX1
 *           and UBT3, UBT2, UBT1 count down (UBT1 to NIX3) and boot NixOS;
 *           anything else boots FriendlyWrt, which only the vendor U-Boot
 *           can boot
 *   word 1  FTRY: one trial boot of this FIT, which NixOS asked for: zero
 *           sector 0x4000 first, so that whatever happens next the boot after
 *           this one is the vendor U-Boot's, and write FRUN. NixOS writes the
 *           header back once this boot is healthy (r76s-boot-state renew).
 *           This U-Boot writes FRSC when it hands over to the vendor U-Boot
 *           for FriendlyWrt and FOFF when it cannot boot a kernel safely
 *           (the OP-TEE memory is not left out of the DRAM banks).
 * The watchdog runs from early in U-Boot (CONFIG_WATCHDOG_AUTOSTART), so a
 * hang after that ends in a reset.
 */
r76s_buf=0x40c00000
r76s_zero=0x40c01000
r76s_misc=0x7000
r76s_fit=0x4000

r76s_fit_off=
	mw.l ${r76s_zero} 0 0x80;
	mmc write ${r76s_zero} ${r76s_fit} 1

/* Hand over to the vendor U-Boot: mark the reason in word 1 and reset */
r76s_to_vendor=
	if test "${r76s_ft}" != 4e555246; then
		run r76s_fit_off;
		mw.l ${r76s_mark} ${r76s_why};
		mmc write ${r76s_buf} ${r76s_misc} 1;
	fi;
	reset

r76s_boot=
	mmc dev 0 || reset;
	mmc read ${r76s_buf} ${r76s_misc} 1 || reset;
	setexpr r76s_mark ${r76s_buf} + 4;
	setexpr.l r76s_st *${r76s_buf};
	setexpr.l r76s_ft *${r76s_mark};
	if test "${r76s_ft}" = 59525446; then
		run r76s_fit_off || reset;
		mw.l ${r76s_mark} 0x4e555246;
		mmc write ${r76s_buf} ${r76s_misc} 1 || reset;
		setenv r76s_ft 4e555246;
	fi;
	setenv r76s_nx;
	if test "${r76s_st}" = 3358494e; then setenv r76s_nx 0x3258494e; fi;
	if test "${r76s_st}" = 3258494e; then setenv r76s_nx 0x3158494e; fi;
	if test "${r76s_st}" = 3158494e; then setenv r76s_nx 0; fi;
	if test "${r76s_st}" = 33544255; then setenv r76s_nx 0x32544255; fi;
	if test "${r76s_st}" = 32544255; then setenv r76s_nx 0x31544255; fi;
	if test "${r76s_st}" = 31544255; then setenv r76s_nx 0x3358494e; fi;
	if env exists r76s_nx; then
		if r76s optee; then
			mw.l ${r76s_buf} ${r76s_nx};
			mmc write ${r76s_buf} ${r76s_misc} 1 || reset;
			r76s info;
			sysboot mmc 0:b any ${pxefile_addr_r} /extlinux/extlinux.conf;
			reset;
		fi;
		setenv r76s_why 0x46464f46;
		run r76s_to_vendor;
	fi;
	setenv r76s_why 0x43535246;
	run r76s_to_vendor
